<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:element name="control">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="idServidor" type="xs:int"/>
        <xs:element name="operacion">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="FORMATO"/>
              <xs:enumeration value="FRECUENCIA"/>
              <xs:enumeration value="UNIDADES"/>
              <xs:enumeration value="ENVIO"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="parametro" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>